<!-- Global Toast Container -->
<div id="toast-container" class="toast-container"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div id="tempDataSuccess" style="display:none;" data-message="@TempData["SuccessMessage"]"></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="tempDataError" style="display:none;" data-message="@TempData["ErrorMessage"]"></div>
}

<script>
    window.showToast = function(message, type = 'success', redirectUrl = null, duration = 4000) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const card = document.createElement('div');
        card.className = `toast-card toast-${type}`;
        if (redirectUrl) {
            card.style.cursor = 'pointer';
        }

        let icon = 'ℹ️';
        if (type === 'success') icon = '✅';
        else if (type === 'error') icon = '❌';
        else if (type === 'warning') icon = '⚠️';

        card.innerHTML = `
            <div class="toast-icon">${icon}</div>
            <div class="toast-content">
                <p class="toast-message">${message}</p>
                ${redirectUrl ? '<small style="font-size: 11px; opacity: 0.8; display: block; margin-top: 4px; text-decoration: underline;">👉 Nhấp vào đây để học ngay!</small>' : ''}
            </div>
        `;

        container.appendChild(card);

        // Trigger animate-in
        setTimeout(() => card.classList.add('show'), 10);

        // Auto-remove after duration
        const autoHide = setTimeout(() => {
            card.classList.remove('show');
            card.classList.add('hide');
            setTimeout(() => card.remove(), 400);
        }, duration);

        // Click to dismiss / redirect
        card.onclick = () => {
            clearTimeout(autoHide);
            card.classList.remove('show');
            card.classList.add('hide');
            setTimeout(() => {
                card.remove();
                if (redirectUrl) {
                    window.location.href = redirectUrl;
                }
            }, 400);
        };
    };

    document.addEventListener("DOMContentLoaded", function() {
        const successEl = document.getElementById('tempDataSuccess');
        const errorEl = document.getElementById('tempDataError');
        if (successEl) showToast(successEl.getAttribute('data-message'), 'success');
        if (errorEl) showToast(errorEl.getAttribute('data-message'), 'error');
    });
</script>

<!-- Google Translate Widget Elements -->
<div id="google_translate_element" style="display:none;"></div>
<script type="text/javascript">
    function googleTranslateElementInit() {
        new google.translate.TranslateElement({
            pageLanguage: 'vi',
            includedLanguages: 'en,vi',
            layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
            autoDisplay: false
        }, 'google_translate_element');
    }
</script>
<script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<script>
    function changeSystemLanguage(lang) {
        let domain = window.location.hostname;
        if (lang === 'en') {
            document.cookie = "googtrans=/vi/en; path=/; domain=" + domain;
            document.cookie = "googtrans=/vi/en; path=/";
            document.cookie = "selected_lang=en; path=/; domain=" + domain;
            document.cookie = "selected_lang=en; path=/";
        } else {
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + domain;
            document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/";
            document.cookie = "selected_lang=vi; path=/; domain=" + domain;
            document.cookie = "selected_lang=vi; path=/";
        }
        window.location.reload();
    }

    document.addEventListener("DOMContentLoaded", function() {
        // Highlight active flag based on Cookie
        let match = document.cookie.match(new RegExp('(^| )selected_lang=([^;]+)'));
        let currentLang = match ? match[2] : 'vi';
        
        let flagVi = document.getElementById('lang-vi');
        let flagEn = document.getElementById('lang-en');
        if (flagVi && flagEn) {
            if (currentLang === 'en') {
                flagVi.style.opacity = '0.4';
                flagVi.classList.remove('active-lang');
                flagEn.style.opacity = '1';
                flagEn.classList.add('active-lang');
            } else {
                flagVi.style.opacity = '1';
                flagVi.classList.add('active-lang');
                flagEn.style.opacity = '0.4';
                flagEn.classList.remove('active-lang');
            }
        }

        // Highlight active flag in Mobile Drawer
        let flagViMobile = document.getElementById('lang-vi-mobile');
        let flagEnMobile = document.getElementById('lang-en-mobile');
        if (flagViMobile && flagEnMobile) {
            if (currentLang === 'en') {
                flagViMobile.classList.remove('active-lang');
                flagEnMobile.classList.add('active-lang');
            } else {
                flagViMobile.classList.add('active-lang');
                flagEnMobile.classList.remove('active-lang');
            }
        }

        // Mobile Menu Drawer interactions
        const openBtn = document.getElementById('openDrawerBtn');
        const closeBtn = document.getElementById('closeDrawerBtn');
        const drawer = document.getElementById('mobileMenuDrawer');
        const overlay = document.getElementById('mobileMenuOverlay');

        if (openBtn && closeBtn && drawer && overlay) {
            function openDrawer() {
                drawer.classList.add('open');
                overlay.classList.add('open');
                document.body.style.overflow = 'hidden'; // Disable scroll behind
            }

            function closeDrawer() {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
                document.body.style.overflow = ''; // Restore scroll
            }

            openBtn.addEventListener('click', openDrawer);
            closeBtn.addEventListener('click', closeDrawer);
            overlay.addEventListener('click', closeDrawer);
        }
    });
</script>

@if (User.Identity?.IsAuthenticated == true)
{
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@latest/dist/browser/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            const badge = document.getElementById("notificationBadge");
            const notifList = document.getElementById("notificationList");
            const dropdown = document.getElementById("notificationListDropdown");
            const bellBtn = document.getElementById("notificationBellBtn");
            const clearBtn = document.getElementById("clearNotifBtn");

            // Fetch notifications on load
            function loadNotifications() {
                fetch('/Home/GetNotifications')
                    .then(res => res.json())
                    .then(data => {
                        if (notifList) {
                            if (data && data.length > 0) {
                                notifList.innerHTML = "";
                                let unreadCount = 0;
                                data.forEach(n => {
                                    if (!n.isRead) unreadCount++;
                                    const notifItem = document.createElement("div");
                                    notifItem.style.padding = "8px 12px";
                                    notifItem.style.borderRadius = "8px";
                                    notifItem.style.backgroundColor = n.isRead ? "#ffffff" : "#f8fafc";
                                    notifItem.style.borderLeft = n.isRead ? "3px solid #e2e8f0" : "3px solid #4f46e5";
                                    notifItem.style.marginBottom = "4px";
                                    notifItem.style.cursor = "pointer";
                                    notifItem.innerHTML = `
                                        <div style="font-weight: ${n.isRead ? 'normal' : '600'};">${n.message}</div>
                                        <div style="font-size: 11px; color: #64748b; margin-top: 2px;">${n.createdAt}</div>
                                    `;
                                    notifItem.addEventListener("click", () => {
                                        if (dropdown) dropdown.style.display = "none";

                                        if (!n.isRead) {
                                            fetch(`/Home/MarkNotificationAsRead?id=${n.id}`, { method: 'POST' })
                                                .then(() => {
                                                    loadNotifications();
                                                })
                                                .catch(err => console.error("Error marking single notification as read:", err));
                                        }

                                        // Redirect student to the dynamic computed URL
                                        window.location.href = n.url || "/Manage";
                                    });
                                    notifList.appendChild(notifItem);
                                });

                                if (unreadCount > 0) {
                                    badge.textContent = unreadCount;
                                    badge.style.display = "inline-block";
                                } else {
                                    badge.style.display = "none";
                                }
                            } else {
                                notifList.innerHTML = `<div style="text-align: center; color: #64748b; padding: 10px; font-style: italic;">Chưa có thông báo mới</div>`;
                                badge.style.display = "none";
                            }
                        }
                    })
                    .catch(err => console.error("Error loading notifications:", err));
            }

            loadNotifications();

            if (bellBtn && dropdown) {
                bellBtn.addEventListener("click", function(e) {
                    e.stopPropagation();
                    const isVisible = dropdown.style.display === "block";
                    dropdown.style.display = isVisible ? "none" : "block";
                });
                
                document.addEventListener("click", function() {
                    dropdown.style.display = "none";
                });

                dropdown.addEventListener("click", function(e) {
                    e.stopPropagation();
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener("click", function() {
                    fetch('/Home/MarkNotificationsAsRead', { method: 'POST' })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                if (badge) {
                                    badge.textContent = "0";
                                    badge.style.display = "none";
                                }
                                loadNotifications();
                            }
                        })
                        .catch(err => console.error("Error marking notifications as read:", err));
                });
            }

            connection.on("ReceiveNotification", function(message) {
                if (window.showToast) {
                    window.showToast(message, "success");
                } else {
                    alert(message);
                }
                loadNotifications();
            });

            connection.start().catch(function(err) {
                console.error("SignalR connection failed: ", err.toString());
            });
        });
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>