@model List<Career_Guidance_Platform.Models.PaymentHistory>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports & Revenue Analytics";
    
    // Calculate conversion rate
    int premiumCount = ViewBag.PremiumUsers ?? 0;
    int freeCount = ViewBag.FreeUsers ?? 0;
    int totalCount = premiumCount + freeCount;
    double conversionRate = totalCount > 0 ? ((double)premiumCount / totalCount) * 100 : 0.0;
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Báo cáo & Phân tích</div>
            <h2 class="page-title text-primary"><i class="ti ti-chart-bar me-2"></i>Thống kê doanh thu Premium</h2>
        </div>
        <div class="col-auto ms-auto d-flex gap-2">
            <button onclick="window.print();" class="btn btn-outline-secondary">
                <i class="ti ti-printer me-1"></i> In báo cáo
            </button>
        </div>
    </div>
</div>

<!-- Thống kê tổng quan -->
<div class="row row-deck row-cards mb-4">
    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Admin" asp-action="Transactions" class="card bg-primary-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-primary">Tổng doanh thu (USD)</div>
                    <span class="avatar bg-primary text-white"><i class="ti ti-currency-dollar"></i></span>
                </div>
                <div class="h1 mb-1 text-primary">$@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</div>
                <div class="text-muted text-truncate">Cộng dồn từ giao dịch thành công (Xem chi tiết)</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Admin" asp-action="Transactions" asp-route-status="Completed" class="card bg-success-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-success">Số lượt nâng cấp</div>
                    <span class="avatar bg-success text-white"><i class="ti ti-shopping-cart"></i></span>
                </div>
                <div class="h1 mb-1 text-success">@ViewBag.TotalTransactions</div>
                <div class="text-muted text-truncate">Thanh toán Premium thành công (Xem chi tiết)</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <a asp-controller="Admin" asp-action="Transactions" asp-route-status="Completed" class="card bg-info-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-info">Thành viên Premium</div>
                    <span class="avatar bg-info text-white"><i class="ti ti-user-check"></i></span>
                </div>
                <div class="h1 mb-1 text-info">@premiumCount</div>
                <div class="text-muted text-truncate">Trên tổng số @totalCount người dùng (Xem chi tiết)</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card bg-warning-lt">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-warning">Tỷ lệ chuyển đổi (CVR)</div>
                    <span class="avatar bg-warning text-white"><i class="ti ti-percentage"></i></span>
                </div>
                <div class="h1 mb-1 text-warning">@conversionRate.ToString("0.0")%</div>
                <div class="text-muted text-truncate">Tỷ lệ nâng cấp VIP thành công</div>
            </div>
        </div>
    </div>
</div>

<!-- Chi tiết trạng thái giao dịch -->
<div class="row row-deck row-cards mb-4">
    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Transactions" asp-route-status="Completed" class="card bg-success-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-success">Thanh toán thành công</div>
                    <span class="avatar bg-success text-white"><i class="ti ti-check"></i></span>
                </div>
                <div class="h1 mb-1 text-success">@ViewBag.CompletedCount</div>
                <div class="text-muted text-truncate">Giao dịch đã hoàn tất thành công (Xem chi tiết)</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Transactions" asp-route-status="Cancelled" class="card bg-danger-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-danger">Giao dịch đã hủy</div>
                    <span class="avatar bg-danger text-white"><i class="ti ti-x"></i></span>
                </div>
                <div class="h1 mb-1 text-danger">@ViewBag.CancelledCount</div>
                <div class="text-muted text-truncate">Giao dịch do người dùng hủy bỏ (Xem chi tiết)</div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Transactions" asp-route-status="Pending" class="card bg-warning-lt hover-shadow-sm" style="text-decoration: none; display: block; transition: all 0.2s ease-in-out;">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="subheader text-warning">Đang chờ thanh toán</div>
                    <span class="avatar bg-warning text-white"><i class="ti ti-clock"></i></span>
                </div>
                <div class="h1 mb-1 text-warning">@ViewBag.PendingCount</div>
                <div class="text-muted text-truncate">Giao dịch đang chờ hoặc chưa hoàn tất (Xem chi tiết)</div>
            </div>
        </a>
    </div>
</div>


<!-- Biểu đồ phân tích -->
<div class="row row-cards mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-trending-up me-2"></i>Xu hướng doanh thu</h3>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <div class="btn-group btn-group-sm" role="group" id="revenueQuickFilterGroup">
                        <button type="button" class="btn btn-outline-primary" onclick="filterRevenue('1week', this)">1 Tuần</button>
                        <button type="button" class="btn btn-outline-primary" onclick="filterRevenue('1month', this)">1 Tháng</button>
                        <button type="button" class="btn btn-outline-primary active" onclick="filterRevenue('6months', this)">6 Tháng</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Tùy chỉnh:</span>
                        <input type="date" id="revenueStartDate" class="form-control form-control-sm" onchange="filterCustomRevenue()">
                        <span class="small text-muted">đến</span>
                        <input type="date" id="revenueEndDate" class="form-control form-control-sm" onchange="filterCustomRevenue()">
                    </div>
                </div>
                <div style="height: 320px;">
                    <canvas id="revenueTrendChart" style="width: 100%; height: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-users me-2"></i>Cơ cấu người dùng</h3>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="width: 230px; height: 230px; margin-bottom: 20px;">
                    <canvas id="userBreakdownChart"></canvas>
                </div>
                <div class="d-flex gap-4">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary" style="width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
                        <span>Premium (@premiumCount)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary" style="width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
                        <span>Free (@freeCount)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // Tham chiếu global tới 2 biểu đồ để các hàm filter bên ngoài DOMContentLoaded có thể truy cập
        let revenueChart;
        let userChart;

        document.addEventListener("DOMContentLoaded", function () {
            // Chặn cứng không cho chọn ngày tương lai ở bộ lọc tùy chỉnh
            const todayStr = new Date().toISOString().split('T')[0];
            document.getElementById('revenueStartDate').setAttribute('max', todayStr);
            document.getElementById('revenueEndDate').setAttribute('max', todayStr);

            // Line Chart: Doanh thu 6 tháng gần nhất (mặc định)
            const ctxTrend = document.getElementById('revenueTrendChart').getContext('2d');
            const monthlyLabels = @Html.Raw(Json.Serialize(ViewBag.MonthlyLabels ?? new List<string>()));
            const monthlyValues = @Html.Raw(Json.Serialize(ViewBag.MonthlyValues ?? new List<decimal>()));
            
            revenueChart = new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Doanh thu ($)',
                        data: monthlyValues,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 3,
                        pointBackgroundColor: '#0d6efd',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    onClick: function(evt, elements) {
                        const activePoints = revenueChart.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
                        if (activePoints.length > 0) {
                            const firstPoint = activePoints[0];
                            const label = revenueChart.data.labels[firstPoint.index]; // Ví dụ: "Tháng 07" hoặc "07/2026"
                            const match = label.match(/\d+/);
                            if (match) {
                                const month = match[0]; // Trích xuất chỉ số số của tháng
                                window.location.href = `/Admin/Transactions?month=${month}`;
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` Doanh thu: $${context.raw.toFixed(2)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                borderDash: [2, 4],
                                color: 'rgba(100, 116, 139, 0.12)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                },
                                font: {
                                    family: 'Outfit, Inter, sans-serif'
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    family: 'Outfit, Inter, sans-serif'
                                }
                            }
                        }
                    }
                }
            });

            // Doughnut Chart: Cơ cấu tài khoản
            const ctxBreakdown = document.getElementById('userBreakdownChart').getContext('2d');
            const premiumCount = @premiumCount;
            const freeCount = @freeCount;

            userChart = new Chart(ctxBreakdown, {
                type: 'doughnut',
                data: {
                    labels: ['Premium', 'Free'],
                    datasets: [{
                        // Đồng bộ màu Premium (#0d6efd) trùng khớp với chấm chú thích bg-primary bên dưới
                        data: [premiumCount, freeCount],
                        backgroundColor: ['#0d6efd', '#9ca3af'],
                        borderWidth: 3,
                        borderColor: '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    // Điều hướng sang trang Users, lọc theo loại tài khoản được click
                    onClick: (evt, activeElements) => {
                        if (activeElements.length > 0) {
                            const firstPoint = activeElements[0];
                            const label = userChart.data.labels[firstPoint.index]; // "Premium" hoặc "Free"
                            window.location.href = `/Admin/Users?accountType=${label}`;
                        }
                    }
                }
            });
        });

        // ==========================================
        // Bộ lọc thời gian thông minh cho biểu đồ Doanh thu
        // ==========================================
        function setActiveQuickFilterButton(btn) {
            document.querySelectorAll('#revenueQuickFilterGroup .btn').forEach(b => b.classList.remove('active'));
            if (btn) {
                btn.classList.add('active');
            }
        }

        function updateRevenueChartData(labels, values) {
            if (!revenueChart) return;
            revenueChart.data.labels = labels;
            revenueChart.data.datasets[0].data = values;
            revenueChart.update();
        }

        async function filterRevenue(range, btn) {
            setActiveQuickFilterButton(btn);
            // Xóa lựa chọn ngày tùy chỉnh khi dùng nút nhanh
            document.getElementById('revenueStartDate').value = '';
            document.getElementById('revenueEndDate').value = '';

            try {
                const res = await fetch(`/Admin/GetRevenueData?range=${encodeURIComponent(range)}`);
                if (!res.ok) throw new Error('Không thể tải dữ liệu doanh thu');
                const result = await res.json();
                updateRevenueChartData(result.labels, result.values);
            } catch (err) {
                console.error('Lỗi khi lọc doanh thu theo khoảng thời gian nhanh:', err);
            }
        }

        async function filterCustomRevenue() {
            const startDate = document.getElementById('revenueStartDate').value;
            const endDate = document.getElementById('revenueEndDate').value;

            // Chờ cho đến khi cả hai ngày được chọn
            if (!startDate || !endDate) return;

            if (startDate > endDate) {
                alert('Ngày bắt đầu không được lớn hơn ngày kết thúc.');
                return;
            }

            setActiveQuickFilterButton(null);

            try {
                const res = await fetch(`/Admin/GetRevenueData?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`);
                if (!res.ok) throw new Error('Không thể tải dữ liệu doanh thu tùy chỉnh');
                const result = await res.json();
                updateRevenueChartData(result.labels, result.values);
            } catch (err) {
                console.error('Lỗi khi lọc doanh thu theo khoảng ngày tùy chỉnh:', err);
            }
        }
    </script>
}