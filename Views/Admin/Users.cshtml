@model IEnumerable<Career_Guidance_Platform.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
}

<div class="page-header d-print-none mb-3">
    <div class="mb-2">
        <a href="/Admin/Dashboard" class="btn btn-outline-secondary btn-sm">
            ⬅️ Quay lại Bảng điều khiển
        </a>
    </div>
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Management</div>
            <h2 class="page-title">Users</h2>
        </div>

        <div class="col-auto ms-auto">
            <button class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#userModal"
                    onclick="openAddUserModal()">
                <i class="ti ti-plus me-1"></i>
                Add User
            </button>
        </div>
    </div>
</div>

<div class="card">

    <div class="card-body border-bottom py-3">
        <div class="row g-2">

            <div class="col-md-3">
                <input id="searchInput"
                       type="search"
                       class="form-control"
                       placeholder="Search user..."
                       onkeyup="filterUsers()"
                       autocomplete="new-password" />
            </div>

            <div class="col-md-2">
                <select id="roleFilter"
                        class="form-select"
                        onchange="filterUsers()">
                    <option value="">All Roles</option>
                    <option value="User">User</option>
                    <option value="Mentor">Mentor</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div class="col-md-2">
                <select id="statusFilter"
                        class="form-select"
                        onchange="filterUsers()">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Pending">Pending</option>
                    <option value="Blocked">Blocked</option>
                </select>
            </div>

            <div class="col-md-3">
                <select id="membershipFilter"
                        class="form-select"
                        onchange="filterUsers()">
                    <option value="">All Membership</option>
                    <option value="premium">Premium</option>
                    <option value="free">Regular</option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100"
                        onclick="filterUsers()">
                    Filter
                </button>
            </div>

        </div>
    </div>

    <div class="table-responsive">

        <table class="table table-vcenter card-table">

            <thead>
            <tr>
                <th width="40">
                    <input type="checkbox" class="form-check-input">
                </th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Membership</th>
                <th>Status</th>
                <th width="150">Actions</th>
            </tr>
            </thead>

            <tbody id="userTableBody">
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    var displayRole = user.Role == "Student" ? "User" : user.Role;
                    var displayStatus = user.Status == 1 ? "Active" : (user.Status == 2 ? "Pending" : "Blocked");
                    var badgeClass = user.Status == 1 ? "bg-green-lt" : (user.Status == 2 ? "bg-yellow-lt" : "bg-red-lt");
                    <tr class="user-row" data-premium="@user.IsPremium.ToString().ToLower()">
                        <td>
                            <input type="checkbox" class="form-check-input">
                        </td>
                        <td class="user-name">@user.FullName</td>
                        <td class="user-email">@user.Email</td>
                        <td class="user-role">@displayRole</td>
                        <td>
                            @if (user.IsPremium)
                            {
                                <span class="badge bg-purple-lt"><i class="ti ti-crown me-1"></i>Premium</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-lt">Regular</span>
                            }
                        </td>
                        <td>
                            <span class="badge status-badge @badgeClass">@displayStatus</span>
                        </td>
                        <td class="table-actions">
                            <button class="btn btn-icon btn-sm btn-outline-info me-1 view-details-btn"
                                    data-id="@user.Id"
                                    data-fullname="@user.FullName"
                                    data-email="@user.Email"
                                    data-role="@displayRole"
                                    data-status="@displayStatus"
                                    data-premium="@user.IsPremium.ToString().ToLower()"
                                    data-created="@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                                    data-headline="@user.Headline"
                                    data-school="@user.School"
                                    data-major="@user.Major"
                                    data-experience="@user.Experience"
                                    title="Xem chi tiết">
                                <i class="ti ti-eye"></i>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-action-edit"
                                    data-id="@user.Id"
                                    data-fullname="@user.FullName"
                                    data-email="@user.Email"
                                    data-role="@displayRole"
                                    data-status="@displayStatus"
                                    data-bs-toggle="modal"
                                    data-bs-target="#userModal">
                                Edit
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-danger btn-action-delete"
                                    data-id="@user.Id">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-3">No users found in database.</td>
                </tr>
            }
            </tbody>

        </table>

    </div>

    <div class="card-footer d-flex align-items-center justify-content-between">
        <span id="entryText">
            Showing 1 to @(Model?.Count() ?? 0) entries
        </span>
        <ul class="pagination m-0 ms-auto" id="pagination-ul">
        </ul>
    </div>

</div>

<!-- Modal -->

<div class="modal modal-blur fade"
     id="userModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="modalTitle">
                    Add User
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="editingUserId">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Full Name
                        </label>

                        <input id="fullNameInput"
                               class="form-control">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Email
                        </label>

                        <input id="emailInput"
                               type="email"
                               class="form-control">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Role
                        </label>

                        <select id="roleInput"
                                class="form-select">
                            <option>User</option>
                            <option>Mentor</option>
                            <option>Admin</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            Status
                        </label>

                        <select id="statusInput"
                                class="form-select">
                            <option>Active</option>
                            <option>Pending</option>
                            <option>Blocked</option>
                        </select>
                    </div>

                    <div class="col-12 mb-3" id="passwordGroup">
                        <label class="form-label">
                            Password <span class="text-muted">(Default: User@123456)</span>
                        </label>
                        <input id="passwordInput"
                               type="password"
                               class="form-control"
                               placeholder="Enter password or leave blank for default">
                    </div>



                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-primary"
                        onclick="saveUser()">
                    Save User
                </button>

            </div>

        </div>

    </div>

</div>

<!-- Modal Xem Chi Tiết Người Dùng -->
<div class="modal modal-blur fade" id="userViewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-user me-2 text-primary"></i>Hồ sơ chi tiết người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-4">
                    <span class="avatar avatar-lg me-3 bg-primary-lt" id="viewUserAvatar" style="font-size: 24px; font-weight: 700;"></span>
                    <div>
                        <h4 class="m-0 font-weight-bold" id="viewUserFullName"></h4>
                        <small class="text-muted" id="viewUserEmail"></small>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Vai trò</label>
                        <div class="font-weight-medium" id="viewUserRole"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Trạng thái</label>
                        <div id="viewUserStatus"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Hạng thành viên</label>
                        <div id="viewUserMembership"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Ngày tạo tài khoản</label>
                        <div class="font-weight-medium" id="viewUserCreatedAt"></div>
                    </div>
                    <div class="col-12" id="viewUserHeadlineGroup">
                        <label class="form-label text-muted mb-1">Tiêu đề cá nhân</label>
                        <div class="font-weight-medium text-dark" id="viewUserHeadline"></div>
                    </div>
                    <div class="col-6" id="viewUserSchoolGroup">
                        <label class="form-label text-muted mb-1">Trường học</label>
                        <div class="font-weight-medium text-dark" id="viewUserSchool"></div>
                    </div>
                    <div class="col-6" id="viewUserMajorGroup">
                        <label class="form-label text-muted mb-1">Chuyên ngành</label>
                        <div class="font-weight-medium text-dark" id="viewUserMajor"></div>
                    </div>
                    <div class="col-12" id="viewUserExperienceGroup">
                        <label class="form-label text-muted mb-1">Kinh nghiệm làm việc</label>
                        <div class="bg-light p-2 rounded text-secondary" id="viewUserExperience" style="white-space: pre-line; font-size: 13px;"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/admin/users.js" asp-append-version="true"></script>
}