@model List<Career_Guidance_Platform.Models.PaymentHistory>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch sử giao dịch Premium";
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Báo cáo & Phân tích</div>
            <h2 class="page-title text-primary"><i class="ti ti-list me-2"></i>Lịch sử giao dịch Premium</h2>
        </div>
        <div class="col-auto ms-auto d-flex gap-2">
            <a asp-controller="Admin" asp-action="Reports" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Quay lại Báo cáo
            </a>
            <button onclick="exportExcel();" class="btn btn-success text-white">
                <i class="ti ti-file-spreadsheet me-1"></i> Xuất Excel
            </button>
            <button onclick="window.print();" class="btn btn-outline-secondary">
                <i class="ti ti-printer me-1"></i> In danh sách
            </button>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card mb-4 d-print-none">
    <div class="card-header">
        <h3 class="card-title"><i class="ti ti-filter me-2"></i>Bộ lọc tìm kiếm giao dịch</h3>
    </div>
    <div class="card-body">
        <form method="get" asp-controller="Admin" asp-action="Transactions" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm người dùng</label>
                <div class="input-icon">
                    <span class="input-icon-addon">
                        <i class="ti ti-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Nhập tên hoặc email..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed" ? "selected" : null)">Completed (Thành công)</option>
                    <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending" ? "selected" : null)">Pending (Đang chờ)</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled" ? "selected" : null)">Cancelled (Đã hủy)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Chọn nhanh</label>
                <select id="timeRangeFilter" name="timeRange" class="form-select">
                    <option value="all" selected="@(ViewBag.SelectedTimeRange == "all" || string.IsNullOrEmpty(ViewBag.SelectedTimeRange) ? "selected" : null)">Tất cả thời gian</option>
                    <option value="1day" selected="@(ViewBag.SelectedTimeRange == "1day" ? "selected" : null)">Trong 24 giờ qua</option>
                    <option value="1week" selected="@(ViewBag.SelectedTimeRange == "1week" ? "selected" : null)">Trong 1 tuần qua</option>
                    <option value="1month" selected="@(ViewBag.SelectedTimeRange == "1month" ? "selected" : null)">Trong 1 tháng qua</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Từ ngày</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Đến ngày</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="ti ti-search me-1"></i> Lọc
                </button>
                <a asp-controller="Admin" asp-action="Transactions" class="btn btn-outline-secondary px-4">
                    Xóa
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Chi tiết giao dịch -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title"><i class="ti ti-list me-2"></i>Lịch sử nâng cấp Premium</h3>
        <span class="badge bg-blue-lt">@Model.Count giao dịch</span>
    </div>
    
    <div class="table-responsive">
        <table class="table table-vcenter card-table table-striped table-hover">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Khách hàng</th>
                    <th>Mã đơn hàng PayPal</th>
                    <th>Số tiền</th>
                    <th>Thời gian</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody id="transactionsTableBody">
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var payment in Model)
                    {
                        <tr class="payment-row">
                            <td>@index</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm bg-blue-lt me-2">@payment.User?.FullName?[0].ToString().ToUpper()</span>
                                    <div>
                                        <div class="font-weight-medium">@payment.User?.FullName</div>
                                        <div class="text-muted small">@payment.User?.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="font-monospace text-muted">@payment.PaypalOrderId</span>
                            </td>
                            <td class="font-weight-medium text-success">
                                $@payment.Amount.ToString("0.00") @payment.Currency
                            </td>
                            <td>
                                @payment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center">
                                @if (payment.PaymentStatus == "Completed")
                                {
                                    <span class="badge bg-success-lt"><i class="ti ti-check me-1"></i>Thành công</span>
                                }
                                else if (payment.PaymentStatus == "Pending")
                                {
                                    <span class="badge bg-warning-lt"><i class="ti ti-clock me-1"></i>Đang xử lý</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-lt"><i class="ti ti-x me-1"></i>Thất bại</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-icon btn-sm btn-outline-info view-payment-btn"
                                        data-stt="@index"
                                        data-fullname="@payment.User?.FullName"
                                        data-email="@payment.User?.Email"
                                        data-paypal="@payment.PaypalOrderId"
                                        data-amount="$@payment.Amount.ToString("0.00") @payment.Currency"
                                        data-date="@payment.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                                        data-status="@payment.PaymentStatus"
                                        title="Chi tiết giao dịch">
                                    <i class="ti ti-eye"></i>
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="ti ti-database-off" style="font-size: 28px; display: block; margin-bottom: 8px;"></i>
                            @if (ViewBag.SelectedMonth != null)
                            {
                                <span>Không có giao dịch trong tháng @ViewBag.SelectedMonth</span>
                            }
                            else
                            {
                                <span>Không có dữ liệu giao dịch nào khớp với bộ lọc.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex align-items-center justify-content-between">
        <span id="entryText">
            Showing 1 to 5 of @(Model?.Count() ?? 0) entries
        </span>
        <ul class="pagination m-0 ms-auto" id="pagination-ul">
        </ul>
    </div>
</div>

@section Scripts {
    <script>
        function exportExcel() {
            const search = document.querySelector('input[name="search"]')?.value || '';
            const startDate = document.querySelector('input[name="startDate"]')?.value || '';
            const endDate = document.querySelector('input[name="endDate"]')?.value || '';
            const status = document.querySelector('select[name="status"]')?.value || '';
            const timeRange = document.getElementById('timeRangeFilter')?.value || '';
            window.location.href = `/Admin/ExportToExcel?search=${encodeURIComponent(search)}&startDate=${startDate}&endDate=${endDate}&status=${status}&timeRange=${timeRange}`;
        }

        let rows = [];
        const pageSize = 5;
        let currentPage = 1;

        function initPagination() {
            rows = document.querySelectorAll('.payment-row');
            currentPage = 1;
            paginate();
        }

        function paginate() {
            const totalItems = rows.length;
            const totalPages = Math.ceil(totalItems / pageSize) || 1;

            if (currentPage > totalPages) {
                currentPage = totalPages;
            }

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = startIdx + pageSize;

            rows.forEach((row, idx) => {
                if (idx >= startIdx && idx < endIdx) {
                    row.style.display = '';
                    const sttCell = row.querySelector('td:first-child');
                    if (sttCell) {
                        sttCell.innerText = idx + 1;
                    }
                } else {
                    row.style.display = 'none';
                }
            });

            // Update entry text
            const startEntry = totalItems === 0 ? 0 : startIdx + 1;
            const endEntry = Math.min(endIdx, totalItems);
            document.getElementById('entryText').innerHTML = `Hiển thị từ ${startEntry} đến ${endEntry} trong số ${totalItems} giao dịch`;

            // Render pagination
            const paginationUl = document.getElementById('pagination-ul');
            if (paginationUl) {
                paginationUl.innerHTML = '';

                // Prev Button
                const prevLi = document.createElement('li');
                prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
                prevLi.innerHTML = `<a class="page-link" href="#" tabindex="-1" aria-disabled="${currentPage === 1}"><i class="ti ti-chevron-left"></i> prev</a>`;
                if (currentPage > 1) {
                    prevLi.querySelector('a').addEventListener('click', function(e) {
                        e.preventDefault();
                        currentPage--;
                        paginate();
                    });
                }
                paginationUl.appendChild(prevLi);

                // Page buttons
                const maxButtons = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
                let endPage = Math.min(totalPages, startPage + maxButtons - 1);
                if (endPage - startPage + 1 < maxButtons) {
                    startPage = Math.max(1, endPage - maxButtons + 1);
                }

                for (let i = startPage; i <= endPage; i++) {
                    const li = document.createElement('li');
                    li.className = `page-item ${currentPage === i ? 'active' : ''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.querySelector('a').addEventListener('click', function(e) {
                        e.preventDefault();
                        currentPage = i;
                        paginate();
                    });
                    paginationUl.appendChild(li);
                }

                // Next Button
                const nextLi = document.createElement('li');
                nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
                nextLi.innerHTML = `<a class="page-link" href="#">next <i class="ti ti-chevron-right"></i></a>`;
                if (currentPage < totalPages) {
                    nextLi.querySelector('a').addEventListener('click', function(e) {
                        e.preventDefault();
                        currentPage++;
                        paginate();
                    });
                }
                paginationUl.appendChild(nextLi);
            }
        }

        function applyFilters() {
            const form = document.querySelector('form');
            const searchInput = form.querySelector('input[name="search"]');
            const statusSelect = form.querySelector('select[name="status"]');
            const timeRangeSelect = document.getElementById('timeRangeFilter');
            const startDateInput = form.querySelector('input[name="startDate"]');
            const endDateInput = form.querySelector('input[name="endDate"]');

            const params = new URLSearchParams();
            if (searchInput?.value) params.set('search', searchInput.value);
            if (statusSelect?.value) params.set('status', statusSelect.value);
            if (timeRangeSelect?.value) params.set('timeRange', timeRangeSelect.value);
            if (startDateInput?.value) params.set('startDate', startDateInput.value);
            if (endDateInput?.value) params.set('endDate', endDateInput.value);

            const url = `${window.location.pathname}?${params.toString()}`;

            // Update browser URL without reload
            window.history.pushState(null, '', url);

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    // Replace the table body content
                    const newTableBody = doc.getElementById('transactionsTableBody');
                    const currentTableBody = document.getElementById('transactionsTableBody');
                    if (newTableBody && currentTableBody) {
                        currentTableBody.innerHTML = newTableBody.innerHTML;
                    }

                    // Update total transactions count badge
                    const newBadge = doc.querySelector('.card-header .badge');
                    const currentBadge = document.querySelector('.card-header .badge');
                    if (newBadge && currentBadge) {
                        currentBadge.innerHTML = newBadge.innerHTML;
                    }

                    // Re-run pagination with the new rows
                    initPagination();
                })
                .catch(error => console.error('Error filtering transactions:', error));
        }

        document.addEventListener("DOMContentLoaded", function() {
            initPagination();

            // Intercept form submit (pressing enter in search box or clicking "Lọc")
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    applyFilters();
                });
            }

            // Intercept time range change
            const timeRangeFilter = document.getElementById('timeRangeFilter');
            if (timeRangeFilter) {
                timeRangeFilter.addEventListener('change', function() {
                    const val = this.value;
                    const startDateInput = document.querySelector('input[name="startDate"]');
                    const endDateInput = document.querySelector('input[name="endDate"]');

                    if (val === 'all') {
                        startDateInput.value = '';
                        endDateInput.value = '';
                    } else {
                        const now = new Date();
                        let start = new Date();

                        if (val === '1day') {
                            start.setDate(now.getDate() - 1);
                        } else if (val === '1week') {
                            start.setDate(now.getDate() - 7);
                        } else if (val === '1month') {
                            start.setMonth(now.getMonth() - 1);
                        }

                        const formatDate = (date) => {
                            const y = date.getFullYear();
                            const m = String(date.getMonth() + 1).padStart(2, '0');
                            const d = String(date.getDate()).padStart(2, '0');
                            return `${y}-${m}-${d}`;
                        };

                        startDateInput.value = formatDate(start);
                        endDateInput.value = formatDate(now);
                    }

                    applyFilters();
                });
            }

            // Intercept status change
            const statusSelect = document.querySelector('select[name="status"]');
            if (statusSelect) {
                statusSelect.addEventListener('change', function() {
                    applyFilters();
                });
            }

            // Intercept inputs (change on custom dates triggers filtration)
            const startDateInput = document.querySelector('input[name="startDate"]');
            const endDateInput = document.querySelector('input[name="endDate"]');
            if (startDateInput) startDateInput.addEventListener('change', () => {
                document.getElementById('timeRangeFilter').value = 'all';
                applyFilters();
            });
            if (endDateInput) endDateInput.addEventListener('change', () => {
                document.getElementById('timeRangeFilter').value = 'all';
                applyFilters();
            });

            // Intercept reset (Xóa) link to filter silently without F5
            const resetBtn = document.querySelector('a[href*="/Admin/Transactions"]');
            if (resetBtn) {
                resetBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (form) form.reset();
                    document.getElementById('timeRangeFilter').value = 'all';
                    document.querySelector('input[name="startDate"]').value = '';
                    document.querySelector('input[name="endDate"]').value = '';
                    document.querySelector('input[name="search"]').value = '';
                    document.querySelector('select[name="status"]').value = '';
                    applyFilters();
                });
            }

            // Bind view detail popups
            const tableBody = document.querySelector('.table tbody');
            if (tableBody) {
                tableBody.addEventListener('click', function(e) {
                    const btn = e.target.closest('.view-payment-btn');
                    if (btn) {
                        const name = btn.getAttribute('data-fullname') || 'N/A';
                        const email = btn.getAttribute('data-email') || '';
                        const paypalId = btn.getAttribute('data-paypal') || 'N/A';
                        const amount = btn.getAttribute('data-amount') || '';
                        const date = btn.getAttribute('data-date') || '';
                        const status = btn.getAttribute('data-status') || '';

                        document.getElementById('txCustomerName').innerText = name;
                        document.getElementById('txCustomerEmail').innerText = email;
                        document.getElementById('txPaypalOrderId').innerText = 'PayPal Order ID: ' + paypalId;
                        document.getElementById('txAmount').innerText = amount;
                        document.getElementById('txDate').innerText = date;

                        const avatar = document.getElementById('txAvatar');
                        avatar.innerText = name ? name.charAt(0).toUpperCase() : 'P';

                        const badge = document.getElementById('txStatusBadge');
                        badge.innerText = status === 'Completed' ? 'Thành công' : (status === 'Pending' ? 'Đang xử lý' : 'Thất bại');
                        badge.className = 'badge ' + (status === 'Completed' ? 'bg-success-lt' : (status === 'Pending' ? 'bg-warning-lt' : 'bg-danger-lt'));

                        const myModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('transactionDetailsModal'));
                        myModal.show();
                    }
                });
            }
        });
    </script>
}

<!-- Modal Chi Tiết Giao Dịch -->
<div class="modal modal-blur fade" id="transactionDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-credit-card me-2 text-primary"></i>Chi tiết lịch sử giao dịch PayPal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start">
                <div class="bg-primary-lt p-3 rounded mb-3 text-center">
                    <span class="avatar avatar-md bg-primary text-white mb-2" id="txAvatar" style="font-size: 20px; font-weight: 700;">P</span>
                    <h3 class="m-0 font-weight-bold" id="txAmount" style="color: #1a73e8;"></h3>
                    <small class="text-muted" id="txPaypalOrderId"></small>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label text-muted mb-1">Khách hàng</label>
                        <div class="font-weight-medium text-dark" id="txCustomerName"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted mb-1">Email liên hệ</label>
                        <div class="font-weight-medium text-dark" id="txCustomerEmail"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Thời gian thanh toán</label>
                        <div class="font-weight-medium text-dark" id="txDate"></div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted mb-1">Trạng thái giao dịch</label>
                        <div>
                            <span id="txStatusBadge" class="badge"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
